{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wakil-whatsapp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // Whisper (transcription des vocaux) sur Workers AI
  "ai": { "binding": "AI" },
  // Un Durable Object par conversation client
  "durable_objects": {
    "bindings": [
      { "name": "CONVERSATIONS", "class_name": "ConversationDO" },
      // Boîte de réception lue par l'application (/app)
      { "name": "INBOX", "class_name": "InboxDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConversationDO", "InboxDO"] }],
  // Le script du chat web (public/wakil-chat.js), servi tel quel
  "assets": { "directory": "./public" },
  // Chat web : 20 messages par minute au plus par adresse IP
  "ratelimits": [{ "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  // Les secrets (clés) se mettent avec `npx wrangler secret put NOM`, jamais ici.
  "vars": {
    "CLAUDE_MODEL": "claude-opus-5-5",
    "CLAUDE_EFFORT": "low",
    "GRAPH_API_VERSION": "v23.0",
    "DEBOUNCE_MS": "4000"
  }
}
